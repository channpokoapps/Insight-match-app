{
    "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
    "imports": {
        "@supabase/supabase-js": "https://esm.sh/@supabase/supabase-js@2.45.4"
    },
    "tasks": {
        "check": "deno check sync-insights/index.ts sync-worker/index.ts meta-oauth/index.ts",
        "test": "deno test --allow-env=TOKEN_ENCRYPTION_KEY _shared/",
        "fmt": "deno fmt",
        "lint": "deno lint"
    },
    "lint": {
        "rules": {
            "tags": [
                "recommended"
            ]
        }
    },
    "fmt": {
        "lineWidth": 100,
        "indentWidth": 2,
        "singleQuote": false
    },
    "compilerOptions": {
        "strict": true,
        "lib": [
            "deno.window",
            "dom"
        ]
    }
}